<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Real, reported bug: this SmsReceiver + the READ_SMS/
             RECEIVE_SMS permissions below (this manifest's own prior
             comment already flagged the Play Store policy risk, but
             missed a bigger, more immediate one) are exactly the
             permission combination Android's on-device Play Protect
             scanner treats as a classic SMS-interception/OTP-theft
             malware signature - it can block a sideloaded APK from
             installing AT ALL over this, with a generic "app isn't
             installed" error that gives no hint why, regardless of
             whether the Finance module is ever toggled on in-app (Play
             Protect scans the MANIFEST's declared permissions before
             the app ever runs - an in-app runtime toggle can't
             suppress that). Removed entirely rather than gated, since a
             declared-but-unused permission is still what gets scanned.
             smsFinanceBridge.js's requestPermissions() call (still
             present in code, gated behind Capacitor.isNativePlatform())
             will simply fail cleanly with nothing to request if this
             module is ever re-enabled for native later - re-add this
             receiver and the two permissions below together if that
             happens, understanding the install-risk tradeoff this time. -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Home page weather (WeatherContext.jsx) - city-level accuracy only
         (its own getCurrentPosition call uses enableHighAccuracy: false),
         so only the coarse tier is requested, never FINE. Without this
         declared, the WebView's geolocation permission callback has
         nothing to grant regardless of what the user taps in any runtime
         dialog - the request silently resolves to denied and the app
         falls through to its IP-based fallback tier every time, the
         actual "fails silently" bug this permission fixes. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Tap/action haptic feedback (useMicroFeedback.js's navigator.vibrate
         calls, used throughout tab switches and confirmations) - a
         "normal" protection-level permission, so Android grants it
         automatically at install time with no runtime prompt; simply
         missing from the manifest is what silently no-ops every vibrate()
         call today. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Calendar Hub's native device-calendar bridge
         (utils/nativeCalendarBridge.js, @ebarooni/capacitor-calendar) -
         read-only by design: this only ever imports the device's own
         events INTO Nexus's schedule queue, the exact same one-way
         direction the existing .ics file import already uses, so
         WRITE_CALENDAR is deliberately never requested. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- READ_SMS/RECEIVE_SMS removed - see the real, reported install-
         blocking bug documented on the (now-removed) SmsReceiver
         <receiver> declaration above for the full explanation. -->
</manifest>
