<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Finance Hub's SMS transaction listener (SmsReceiver.java) -
             exported="true" is required here (not a mistake to tighten
             later): SMS_RECEIVED is delivered by the OS as a system
             broadcast, not an explicit same-app Intent, so Android 12+'s
             "every component with an intent-filter must declare exported"
             rule can only be satisfied as true for this one. This does
             NOT open the receiver up to other apps triggering it at
             will - only the system telephony stack can actually send the
             protected android.provider.Telephony.SMS_RECEIVED broadcast
             (enforced by the OS itself), so an arbitrary third-party app
             sending this action does nothing. priority="999" (the
             conventional ceiling for a non-system app) just requests to
             be notified promptly alongside the user's own SMS app - it
             does not consume/abort the broadcast, so the real SMS app
             still receives and stores the message normally. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Home page weather (WeatherContext.jsx) - city-level accuracy only
         (its own getCurrentPosition call uses enableHighAccuracy: false),
         so only the coarse tier is requested, never FINE. Without this
         declared, the WebView's geolocation permission callback has
         nothing to grant regardless of what the user taps in any runtime
         dialog - the request silently resolves to denied and the app
         falls through to its IP-based fallback tier every time, the
         actual "fails silently" bug this permission fixes. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Tap/action haptic feedback (useMicroFeedback.js's navigator.vibrate
         calls, used throughout tab switches and confirmations) - a
         "normal" protection-level permission, so Android grants it
         automatically at install time with no runtime prompt; simply
         missing from the manifest is what silently no-ops every vibrate()
         call today. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Calendar Hub's native device-calendar bridge
         (utils/nativeCalendarBridge.js, @ebarooni/capacitor-calendar) -
         read-only by design: this only ever imports the device's own
         events INTO Nexus's schedule queue, the exact same one-way
         direction the existing .ics file import already uses, so
         WRITE_CALENDAR is deliberately never requested. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Finance Hub's SMS transaction listener (SmsReceiver.java,
         SmsFinancePlugin.java). RECEIVE_SMS is what actually lets
         SmsReceiver's manifest <receiver> below be delivered the
         protected SMS_RECEIVED broadcast at all. READ_SMS is requested
         alongside it for parity with the plugin's declared permission
         group (utils/smsFinanceBridge.js requests both together as one
         "sms" alias) even though the live-listener path above doesn't
         itself call any READ_SMS-gated API - having both granted keeps
         the door open for a future "scan existing inbox on first setup"
         feature without a second permission prompt.
         NOTE (read before shipping to Google Play): READ_SMS/RECEIVE_SMS
         are in Google Play's restricted "Permissions & APIs that Access
         Sensitive Information" policy - Play Console requires the app to
         be the user's default SMS/Assistant/Dialer handler to keep these
         permissions declared, which a finance app cannot realistically
         qualify for. This is fine for a personal/sideloaded APK (not
         going through the Play Store) - confirmed as the intended use
         here - but would need this entire module gated out of any future
         Play Store build. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
</manifest>
